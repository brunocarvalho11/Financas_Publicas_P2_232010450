@ARTICLE{Yang2019,
	author = {Yang, Jie and Song, Lingchuan and Xing, Zhongdan},
	title = {Credit Default of Local Public Sectors in Chinese Government-Pay PPP Projects: Evidence from Ecological Construction},
	year = {2019},
