	affiliations = {Department of Accounting and Taxation, Sumy State University, Ukraine; Verkhovna Rada of Ukraine, Ukraine; Department of Banking Business and Financial Technologies, V. N. Karazin Kharkiv National University, Ukraine; Department of Management and Administration, Vinnytsia Institute of Trade and Economics of SUTE, Ukraine; Economic and Financial Policy Chair, Odessa Regional Institute for Public Administration, National Academy for Public Administration under the President of Ukraine, Ukraine; Department of economics, management and finance, National University of Nicholas V. Sukhomlynsky, Mykolaiv, Ukraine},
