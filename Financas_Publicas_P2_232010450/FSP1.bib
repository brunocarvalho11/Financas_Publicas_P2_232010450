	year = {2023},
	journal = {European Journal of Political Economy},
	volume = {76},
	pages = {},
	doi = {10.1016/j.ejpoleco.2022.102271},
	url = {https://www.scopus.com/pages/publications/85136702941?origin=resultslist},
	affiliations = {Université de Lille, CNRS, IESEG School of Management, UMR 9221 LEM, Lille Economie Management, Lille, F-59000, France; CRED, Université de Paris 2, Assas, France; Université de Rennes 1, Faculté des Sciences Economiques, UMR 6211 CREM. 7, Place Hoche, Rennes Cedex, F-35065, France},
	abstract = {The analysis of French municipalities’ public personnel expenditures allows us to study the issue of the size of the local public sector. We concentrate on two paths that French authorities have followed to limit it, i.e., the promotion of inter-municipal cooperation (IMC) and the cut in grants received by municipalities. Our objective is to evaluate their respective role in the evolution of public personnel expenditures at the municipal level, in a context where local politics comes into play. We consider a large panel dataset of municipalities embedded in IMC structures between 2011 and 2018. Our main results, obtained using an original identification strategy, are threefold. We first find evidence that a substitution effect between municipal and IMC personnel expenditures is at work. Second, we find a partisan distorsion through the grant allocation: despite its formula-based definition, aligned and unaligned municipalities are treated differently by the central government. Third, we show that cuts in grants lead to cuts in municipalities’ public wage bills, while partisanship hinders such cuts. © 2022 Elsevier B.V.},
	author_keywords = {Instrumental variables; Inter-municipal cooperation; Intergovernmental transfers; Local governments; Partisanship; Public sector size},
