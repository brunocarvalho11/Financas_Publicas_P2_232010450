@ARTICLE{Kadochnikov201887,
	author = {Kadochnikov, Denis V.},
	title = {China's budget system at the present stage: Key challenges and development directions; [БЮДЖЕТНАЯ СИСТЕМА КИТАЯ НА СОВРЕМЕННОМ ЭТАПЕ: КЛЮЧЕВЫЕ ВЫЗОВЫ И НАПРАВЛЕНИЯ РАЗВИТИЯ]},
	year = {2018},
	journal = {Terra Economicus},
	volume = {16},
	number = {3},
	pages = {87 - 105},
	doi = {10.23683/2073-6606-2018-16-3-87-105},
